@page "/products"
@using ShoppingCartPlugin.Components
@inject ShoppingCartService CartService

<h1>Our Products</h1>

<div class="product-grid">
    @foreach (var product in products)
    {
        <div class="product-card">
            <h3>@product.Name</h3>
            <p>@product.Price.ToString("C")</p>
            <AddToCartButton Product="product" />
        </div>
    }
</div>

@code {
    private List<ProductDto> products = new()
    {
        new ProductDto { Id = 1, Name = "Premium Widget", Price = 29.99m },
        new ProductDto { Id = 2, Name = "Deluxe Gadget", Price = 49.99m },
        new ProductDto { Id = 3, Name = "Basic Tool", Price = 9.99m },
        new ProductDto { Id = 4, Name = "Super Device", Price = 99.99m }
    };

    public class ProductDto
    {
        public int Id { get; set; }
        public required string Name { get; set; }
        public decimal Price { get; set; }
        public string? ImageUrl { get; set; }
    }
}